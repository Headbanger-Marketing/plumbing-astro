---
import SiteLayout from '../layouts/SiteLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { crumbs, areasSection, verticalCopy } from '../lib/utils';
import { schemaLocalbusiness, schemaBreadcrumb } from '../lib/schema';
import { loadSite } from '../lib/load-site';
const { site } = await loadSite();
const service = verticalCopy(site).serviceName;
const title = `Contact ${site.brand} | ${site.city}, ON`;
const desc = `Request ${service.toLowerCase()} in ${site.city}, Ontario. Share the property location, equipment and work needed to confirm scope and availability.`;
---
<SiteLayout title={title} desc={desc} path="/contact/" active="contact" robots="noindex, follow" schemaBlocks={[
  schemaLocalbusiness(site), schemaBreadcrumb([['Home', '/'], ['Contact', '/contact/']], site)
]}>
  <section class="page-hero">
    <div class="container">
      <Fragment set:html={crumbs([['Home', '/'], ['Contact', '']])} />
      <span class="eyebrow on-dark">{site.city}, Ontario</span>
      <h1>Request {service}</h1>
      <p>{site.enquirySite ? 'Send your job details for review. A provider must be identified and must confirm coverage and availability before a visit can be arranged.' : 'Share what you need at your property. A callback will confirm service scope, coverage and appointment availability.'}</p>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Before you submit</span>
        <h2>Details that help assess your request</h2>
        <p>Include the property location, equipment or fixtures involved, what changed and when the issue began. For a planned installation, describe the equipment you are considering and any access constraints.</p>
        <p>Online requests can be submitted at any time. Submission does not confirm an appointment or an emergency response. For an immediate safety hazard, contact the appropriate emergency service.</p>
        <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
        {!site.hidePhone && <p>Phone: <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></p>}
      </div>
      <div class="split__media">
        <QuoteForm site={site} heading="Request a Quote" sub={site.enquirySite ? 'Your request goes for review. Submission does not book a visit.' : 'A callback will confirm scope and availability.'} idSuffix="contact" placeholder="Describe the issue or planned work." />
      </div>
    </div>
  </section>
  <Fragment set:html={areasSection(site)} />
</SiteLayout>
