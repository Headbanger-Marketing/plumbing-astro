---
// build_pages.py::build_privacy()
import SiteLayout from '../layouts/SiteLayout.astro';
import { crumbs } from '../lib/utils';
import { schemaBreadcrumb } from '../lib/schema';
import { loadSite } from '../lib/load-site';
import { pick } from '../lib/variants';

const { site } = await loadSite();
const SITE_NAME_T = site.brand;

const title = `Privacy Policy | ${SITE_NAME_T}`;
const desc = pick(site.domain, 'privacy/desc', [
  `Privacy policy for ${site.brand}, how we collect, use, and protect your personal information.`,
  `How ${site.brand} handles your personal information: what we collect, why, and your choices.`,
  `Your privacy matters to ${site.brand}. Read what information we collect and how it is protected.`,
]);
const lead = pick(site.domain, 'privacy/lead', [
  `${site.brand} ("we," "us," or "our") respects your privacy. This policy explains what information we collect when you use our website or request our services, and how we use and protect it.`,
  `At ${site.brand}, your personal information is used for one thing: looking after you as a customer. This page explains exactly what we collect and what we do with it.`,
  `This policy describes how ${site.brand} collects, uses, and safeguards your information when you visit our site or request plumbing service.`,
  `Plain version: we collect what you send us, use it to do the work you asked for, and keep it to ourselves. The details are below.`,
  `${site.brand} takes your privacy seriously. Here is exactly what that means in practice.`,
  `Short page, plain language: what we collect, why, and the control you have over it.`,
]);
const pCollect = pick(site.domain, 'privacy/collect', [
  `When you request a quote, we receive the details you enter, including your name, phone, email, service address or location, and a description of the plumbing work. If you email or call us, we also receive what you choose to share in that message or call.`,
  `The form asks for your contact details, job location, and a short description so we can respond. You may also contact us by email or phone. Website delivery and security services may process technical connection information when you visit.`,
  `A quote request gives us your name, phone, email, service location, and information about the plumbing issue. We also receive the details you send by email or give us over the phone. Hosting services may process connection data needed to serve the site.`,
  `We receive the information you submit through the quote form, such as contact details, the property location, and a description of the work. Messages and calls you initiate also give us the details you share. Website services may process basic connection information.`,
  `You choose what to tell us when requesting plumbing service by form, email, or phone. The form asks for your name, contact details, job location, and service needs. Our hosting provider may process technical connection data to deliver and protect these pages.`,
]);
const pUse = pick(site.domain, 'privacy/use', [
  `We use the information you provide to respond to your enquiry, schedule and deliver services, provide quotes, and follow up about your service needs. We do not sell or rent your personal information to third parties.`,
  `Your information goes toward answering you, booking the work, quoting it, and following up afterwards. It is never sold or rented to anyone.`,
  `What you send us is used to reply, schedule, quote, and keep you informed about your service. Selling or renting personal information is not something we do, full stop.`,
  `Your details serve exactly one purpose: delivering the service you asked about. There is no list, no brokerage, and no third-party marketing.`,
  `We use your information to answer you and do the work, nothing else. It is never sold, rented, or traded.`,
]);
const pProtect = pick(site.domain, 'privacy/protect', [
  `We take reasonable measures to protect the personal information you share with us against loss, theft, and unauthorized access. Information is shared only with team members and service partners who need it to serve you.`,
  `Reasonable safeguards protect what you share with us, and access is limited to the staff and service partners who need it to do their part of the job.`,
  `Your details are stored with care, shared only with the people on our side who need them to deliver service, and protected against unauthorized access to the best of our ability.`,
  `Access to customer information is limited to the team members who need it, and reasonable safeguards guard the rest.`,
  `We keep personal information on need-to-know terms inside the company and use sensible measures to keep it secure.`,
  `Customer information stays inside the company, on a need-to-know basis, under sensible safeguards.`,
]);
const pCookies = pick(site.domain, 'privacy/cookies', [
  `We use Google Search Console for aggregate search queries, impressions, clicks, and indexing status. These pages have no visitor analytics script or cookies for visit measurement. Website delivery or security services may use functional cookies in some circumstances.`,
  `Google Search Console helps us understand search visibility and indexing, not your browsing path on this site. We do not run a visitor analytics script. Hosting and security services may use necessary cookies or browser storage; you can manage them in your browser.`,
  `Our performance reports come from Google Search Console search results, including impressions and clicks. We do not use cookies to count site visits. The services that deliver or protect these pages may use functional cookies or storage when needed.`,
  `There is no on-page visitor analytics script here. Google Search Console provides aggregate search and indexing reports. Website hosting or security services may use necessary cookies; your browser settings let you block or clear them, which may affect some functions.`,
  `We review Google Search Console reports about how our pages appear in search. We do not track site visits with cookies. Hosting and security services may use functional browser storage in some cases; most browsers let you manage or clear it.`,
]);
const pChoices = pick(site.domain, 'privacy/choices', [
  `You may request access to, correction of, or deletion of the personal information we hold about you at any time by contacting us using the details below.`,
  `Want to see, fix, or delete the information we hold about you? Contact us using the details below and we will take care of it.`,
  `You control your information. Ask us for a copy, a correction, or a deletion at any time through the contact details below.`,
  `Anything we hold about you can be reviewed, corrected, or removed on request. One message is all it takes.`,
  `Your record with us is yours: request to see it, fix it, or have it deleted whenever you like.`,
]);
const pContactUs = pick(site.domain, 'privacy/contact', [
  `If you have questions about this privacy policy or how your information is handled, please reach out:`,
  `Questions about this policy or your information? Get in touch:`,
  `For anything related to this policy or your personal information, contact us directly:`,
  `Concerns or questions about privacy? The same number and email as everything else:`,
  `Privacy questions go to the same place as everything else, straight to us:`,
]);
---

<SiteLayout
  title={title}
  desc={desc}
  path="/privacy-policy/"
  schemaBlocks={[
    schemaBreadcrumb([
      ['Home', '/'],
      ['Privacy Policy', '/privacy-policy/'],
    ], site),
  ]}
>
<section class="page-hero">
  <div class="container">
    <Fragment set:html={crumbs([['Home', '/'], ['Privacy Policy', '']])} />
    <span class="eyebrow on-dark">Legal</span>
    <h1>Privacy Policy</h1>
    <p>Last updated: <span data-year>2026</span></p>
  </div>
</section>
<section class="section">
  <div class="container">
    <article class="article">
      <p class="lead">{lead}</p>
      <h2>{pick(site.domain, 'privacy/h_collect', ['Information We Collect', 'What We Collect', 'The Details We Ask For'])}</h2>
      <p>{pCollect}</p>
      <h2>{pick(site.domain, 'privacy/h_use', ['How We Use Your Information', 'What Your Information Is For', 'Where Your Details Go'])}</h2>
      <p>{pUse}</p>
      <h2>{pick(site.domain, 'privacy/h_protect', ['How We Protect Your Information', 'Keeping It Safe', 'Our Safeguards'])}</h2>
      <p>{pProtect}</p>
      <h2>{pick(site.domain, 'privacy/h_cookies', ['Search Performance and Cookies', 'Google Search Console and Cookies', 'About Search Reports and Cookies'])}</h2>
      <p>{pCookies}</p>
      <h2>{pick(site.domain, 'privacy/h_choices', ['Your Choices', 'Your Control', 'Your Options'])}</h2>
      <p>{pChoices}</p>
      <h2>{pick(site.domain, 'privacy/h_contact', ['Contact Us', 'Reaching Us', 'Privacy Questions? Contact Us'])}</h2>
      <p>{pContactUs}</p>
      <p>{site.brand}<br>Email: <a href={`mailto:${site.email}`}>{site.email}</a><br>{site.city}, {site.regionAbbr}</p>
    </article>
  </div>
</section>
</SiteLayout>
