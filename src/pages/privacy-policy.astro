---
import SiteLayout from '../layouts/SiteLayout.astro';
import { crumbs } from '../lib/utils';
import { schemaBreadcrumb } from '../lib/schema';
import { loadSite } from '../lib/load-site';
const { site } = await loadSite();
const title = `Privacy Policy | ${site.brand}`;
const desc = `How inquiries through ${site.brand} are received and routed, what information is included, and how to contact us about it.`;
---
<SiteLayout title={title} desc={desc} path="/privacy-policy/" robots="noindex, follow" schemaBlocks={[schemaBreadcrumb([['Home','/'],['Privacy Policy','/privacy-policy/']],site)]}>
<section class="page-hero"><div class="container">
  <Fragment set:html={crumbs([['Home','/'],['Privacy Policy','']])} />
  <span class="eyebrow on-dark">Privacy</span><h1>Privacy Policy</h1><p>Last updated: {site.enquirySite ? 'October 8, 2026' : 'October 4, 2026'}</p>
</div></section>
<section class="section"><div class="container"><article class="article">
  <p class="lead">{site.brand} is a service inquiry website{site.enquirySite ? '.' : " in Headbanger Marketing's portfolio."} This page explains how information submitted through this website or its email address is used in the inquiry process.</p>
  {site.enquirySite && <p>Headbanger Marketing receives and reviews incoming inquiries. The site does not represent a confirmed local service provider.</p>}
  <h2>Information Included in an Inquiry</h2>
  <p>The form collects the contact details, property location, and project description you enter. An inquiry also includes its originating page and submission time. Email inquiries include the sender details and message you provide. Include only the information needed to review the request.</p>
  <h2>Routing and Follow-Up</h2>
  <p>Your inquiry is recorded and routed for review. It may be shared with a relevant service provider so they can respond, confirm coverage and availability, and discuss the proposed work. Submitting a request does not book a visit or confirm a provider's qualifications, pricing, or terms.</p>
  <h2>Services Used to Handle Information</h2>
  <p>Website hosting, email delivery, and inquiry processing services handle information as part of delivering these pages and receiving requests. People handling the inquiry and the responding provider may receive the details required for follow-up.</p>
  <h2>Search Reports and Browser Settings</h2>
  <p>These pages do not run a visitor analytics script. We use Google Search Console for search and indexing reports. Hosting and security services may process connection information or use functional browser storage. Your browser settings let you manage cookies and storage.</p>
  <h2>Questions and Requests</h2>
  <p>You can contact the email address below about information submitted through this website, including a request to review, correct, or delete it. Identify the inquiry and the change requested. If a responding provider has received your details, you may also need to contact that provider about its records.</p>
  <p>{site.brand}<br>Email: <a href={`mailto:${site.email}`}>{site.email}</a><br>{site.city}, {site.regionAbbr}</p>
</article></div></section>
</SiteLayout>
