---
// A direct visit stays neutral; a recent accepted receipt confirms the request.
import SiteLayout from '../layouts/SiteLayout.astro';
import { icon } from '../lib/icons';
import { loadSite } from '../lib/load-site';

const { site } = await loadSite();

const title = `Thank You | ${site.brand}`;
const desc = `Follow-up information for a ${site.city} enquiry. Receipt and appointment confirmation are separate steps.`;

const partner = site.partner;
const partnerUrl = partner?.url;
// Partner logo: png under /assets/img/partners/<slug>.png. Committed to
// public/assets/img/partners/ AND each deploy repo's assets/img/partners/
// (sync KEEP-list doesn't carry new image subdirs). Reads on white card.
// Jayden's logo has black "Mechanical" text.
const partnerSlug = partner?.name
  ? partner.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
  : '';
const partnerLogo = partnerSlug ? `/assets/img/partners/${partnerSlug}.png` : '';
---

<SiteLayout
  title={title}
  desc={desc}
  path="/thank-you/"
  active="contact"
  robots="noindex, follow"
>
  <section class="ty">
    <div class="container ty__card">
      <span class="ty__check ty__check--neutral" data-receipt-badge><span data-status-icon="neutral"><Fragment set:html={icon('mail', '', 36)} /></span><span data-status-icon="received" hidden><Fragment set:html={icon('check', '', 36)} /></span></span>
      <h1 data-receipt-heading>Request Follow-Up</h1>

      {partnerLogo && (
        <span class="ty__partner-badge">
          <img class="ty__partner-logo" src={partnerLogo} alt={`${partner?.name ?? ''} logo`} width="452" height="76" loading="eager" decoding="async" />
        </span>
      )}
      {partner?.tagline && <p class="ty__partner-line">{partner.tagline}</p>}

      <p class="ty__lede" data-receipt-description>If you sent a request, use your chosen contact method for follow-up. Visiting this page does not confirm receipt or book an appointment.</p>

      <div class="ty__warn" data-contact-confirmation>
        <span class="ty__warn-ic"><span data-followup-icon="neutral"><Fragment set:html={icon('headset', '', 20)} /></span><span data-followup-icon="email" hidden><Fragment set:html={icon('mail', '', 20)} /></span><span data-followup-icon="phone" hidden><Fragment set:html={icon('phone', '', 20)} /></span></span>
        <p><strong>Watch for follow-up.</strong> Check the email address or phone number you supplied. Sending a request does not book an appointment.</p>
      </div>

      {!site.hidePhone && <a class="btn btn-primary btn-lg ty__call" href={`tel:${site.phone.tel}`}>
        <Fragment set:html={icon('headset', '', 20)} /> {site.phone.display}
      </a>}
      {!site.hidePhone && <span class="ty__call-sub">Prefer to talk now? Call us directly.</span>}

      <p class="ty__who">Enquiry review by <strong>Jayden's Mechanical</strong>{partnerUrl && <> &middot; <a href={partnerUrl} rel="nofollow noopener" target="_blank">learn more</a></>}</p>
    </div>
  </section>
</SiteLayout>

<style>
  /* Scoped to this page only. Overrides the marketing-page section/card
     spacing so the confirmation reads compact and lead-first. */
  .ty {
    min-height: calc(100vh - 220px);
    display: flex;
    align-items: center;
    padding: 40px 0 60px;
  }
  .ty__card {
    max-width: 560px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .ty__check {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #16a34a, #15803d);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(22, 163, 74, .28);
    margin-bottom: 4px;
  }
  .ty__check--neutral { background: var(--navy); box-shadow: none; }
  .ty__card h1 {
    margin: 0;
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.2rem);
  }
  .ty__lede {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 440px;
  }
  .ty__warn {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 12px;
    padding: 14px 16px;
    margin: 8px 0 6px;
    width: 100%;
    box-sizing: border-box;
  }
  .ty__warn-ic {
    flex-shrink: 0;
    width: 34px; height: 34px;
    border-radius: 8px;
    background: #ea580c;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .ty__warn p {
    margin: 0;
    color: #7c2d12;
    font-size: .98rem;
    line-height: 1.45;
    padding-top: 4px;
  }
  .ty__call {
    margin-top: 8px;
    min-width: 240px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .ty__call-sub {
    margin: 2px 0 14px;
    color: var(--muted-light);
    font-size: .88rem;
  }
  .ty__who {
    margin: 14px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line, #e2e8f0);
    color: var(--muted);
    font-size: .92rem;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  /* Transparent logo wrapper retains the existing artwork and spacing. */
  .ty__partner-badge {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 14px 22px;
    box-shadow: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 2px 0 0;
  }
  .ty__partner-logo {
    height: 44px;
    width: auto;
    display: block;
  }
  .ty__partner-line {
    margin: 0;
    color: var(--muted);
    font-size: .95rem;
    font-style: italic;
  }
  @media (max-width: 560px) {
    .ty__card { gap: 12px; }
    .ty__partner-logo { height: 38px; }
    .ty__partner-badge { padding: 12px 18px; }
  }
</style>

<script is:inline>
try {
  const saved = JSON.parse(sessionStorage.getItem('quote-confirmation') || 'null');
  if(saved && ['email','phone'].includes(saved.channel) && Date.now()-saved.time>=0 && Date.now()-saved.time<3600000){
    document.querySelector('[data-receipt-heading]').textContent='Request received';
    document.querySelector('[data-receipt-description]').textContent="Your request has been received for review. Coverage, pricing, availability and any appointment require separate confirmation.";
    document.querySelector('[data-receipt-badge]').classList.remove('ty__check--neutral');
    document.querySelectorAll('[data-status-icon]').forEach(icon=>icon.hidden=icon.dataset.statusIcon!=='received');
    document.querySelectorAll('[data-followup-icon]').forEach(icon=>icon.hidden=icon.dataset.followupIcon!==saved.channel);
    const text=document.querySelector('[data-contact-confirmation] p');
    if(text)text.textContent=saved.channel==='phone'?'Watch for a phone call using the number you provided. It may come from an unfamiliar number. An appointment still requires confirmation.':'Check the email address you provided for follow-up. An appointment still requires confirmation.';
  }
} catch (_) {}
</script>
