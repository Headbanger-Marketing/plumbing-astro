---
// build_pages.py::build_blog_index()
import SiteLayout from '../../layouts/SiteLayout.astro';
import { schemaLocalbusiness, schemaBreadcrumb } from '../../lib/schema';
import { crumbs, ctaBand, blogCards } from '../../lib/utils';
import { loadSite } from '../../lib/load-site';

const { site, content } = await loadSite();

// Vertical sites (generator/geothermal) are homepage-only — no blog index.
if (site.vertical && site.vertical !== 'hvac') {
  return Astro.redirect('/');
}

const cards = blogCards(content.BLOG, content.BLOG.length);
const title = `${site.city} Service Planning Guides | ${site.brand}`;
const desc = `Read the service scopes for ${site.city} projects and prepare questions for an itemized quote.`;
const heroH1 = content.BLOG.length ? 'Project Planning Articles' : 'Service Planning Guides';
const heroP = content.BLOG.length ? 'Browse the articles below, then confirm the details for your own property.' : 'No articles are published here yet. The service guides below explain the work to discuss with a provider.';

---

<SiteLayout
  title={title}
  desc={desc}
  path="/blog/"
  robots={content.BLOG.length === 0 ? 'noindex, follow' : undefined}
  schemaBlocks={[
    schemaLocalbusiness(site),
    schemaBreadcrumb([
      ['Home', '/'],
      ['Blog', '/blog/'],
    ], site),
  ]}
>
<section class="page-hero">
  <div class="container">
    <Fragment set:html={crumbs([['Home', '/'], ['Blog', '']])} />
    <span class="eyebrow on-dark">Planning resources</span>
    <h1>{heroH1}</h1>
    <p>{heroP}</p>
  </div>
</section>
<section class="section">
  <div class="container">{content.BLOG.length ? <div class="post-grid" set:html={cards}></div> : <ul>{content.HOME_SERVICES.map(([,name,,url])=><li><a href={url} set:html={name}></a></li>)}</ul>}</div>
</section>
<Fragment set:html={ctaBand(site)} />
</SiteLayout>
