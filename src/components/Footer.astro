---
// build.py::footer() + the mobile-bar + the main.js script tag.
import { icon } from '../lib/icons';
import { SERVICES } from '../data/content';
import { verticalCopy } from '../lib/utils';
import type { SiteConfig } from '../lib/types';

interface Props {
  site: SiteConfig;
  svcKeys?: string[]; // filter nav to services this site actually renders
}
const { site, svcKeys } = Astro.props;

const vc = verticalCopy(site);
const svc = vc.hasServicesNav
  ? (svcKeys ? SERVICES.filter((s) => svcKeys.includes(s.slug)) : SERVICES).map((s) => `<a href="/services/${s.slug}/">${s.nav}</a>`).join('')
  : '';
const areas = site.serviceAreas.map((a) => `<li>${a}</li>`).join('');
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand footer-brand" href="/">
          <img class="brand__logo" width="64" height="64" src={site.media?.logo ? `/assets/img/logos/${site.media.logo}` : '/assets/img/logo.png'} alt={site.brand} loading="eager" decoding="async">
        </a>
        <p class="footer-about">{vc.tagline(site.city, site.county)}</p>
      </div>
      <div>
        <h2>Company</h2>
        <div class="footer-links">
          <a href="/">Home</a><a href="/about/">About</a>
          {vc.hasBlog && <a href="/blog/">Blog</a>}
          <a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a>
        </div>
      </div>
      {vc.hasServicesNav && (
        <div>
          <h2>Our Services</h2>
          <div class="footer-links" set:html={svc}></div>
        </div>
      )}
      <div>
        <h2>Get in Touch</h2>
        <ul class="footer-contact">
          <li><Fragment set:html={icon('phone', '', 19)} /><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>
          <li><Fragment set:html={icon('mail', '', 19)} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Fragment set:html={icon('pin', '', 19)} /><span>{site.address.street}, {site.address.locality}, {site.address.region} {site.address.postal}</span></li>
          <li><Fragment set:html={icon('clock', '', 19)} /><span>Open 24 hours · 7 days a week</span></li>
        </ul>
      </div>
    </div>
    <div class="footer-areas">
      <span class="footer-areas__label">Service Areas</span>
      <ul class="footer-areas__list" set:html={areas}></ul>
    </div>
    <div class="footer-bottom">
      <span>&copy; <span data-year>2026</span> {site.brand}. All rights reserved.</span>
      <span><a href="/privacy-policy/">Privacy Policy</a> &nbsp;·&nbsp; <a href="/sitemap-index.xml">Sitemap</a></span>
    </div>
  </div>
</footer>
<div class="mobile-bar mobile-bar--single">
  <a class="btn btn-primary" href="/contact/#quote"><Fragment set:html={icon('send', '', 18)} /> Get a Free Quote</a>
</div>
<script src="/assets/js/main.js" defer></script>
<!-- Portfolio chat widget (brain = n8n "HVAC Chat"; zero-config, skinned from
     theme-color meta, brand from og:site_name). Disable per-site with
     <meta name="hc-chat" content="off"> in the page head. -->
<script src="/assets/js/chat-widget.js" defer></script>
