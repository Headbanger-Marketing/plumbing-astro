---
// build.py::footer() + the mobile-bar + the main.js script tag.
import { existsSync } from 'node:fs';
import { icon } from '../lib/icons';
import { SERVICES } from '../data/content';
import { verticalCopy } from '../lib/utils';
import type { SiteConfig } from '../lib/types';

interface Props {
  site: SiteConfig;
  svcKeys?: string[]; // filter nav to services this site actually renders
}
const { site, svcKeys } = Astro.props;

// The footer sits on navy: prefer the transparent twin (logos-trans/, made by
// scripts/make-logos-transparent.py) over the white-background original.
// Header, favicon, and schema.org keep the white original. SVG logos and
// already-transparent PNGs have no twin and keep their original path.
const footerLogo = (() => {
  const name = site.media?.logo;
  if (!name) return '/assets/img/logo.png';
  if (name.endsWith('.svg')) return `/assets/img/logos/${name}`;
  return existsSync(`public/assets/img/logos-trans/${name}`)
    ? `/assets/img/logos-trans/${name}`
    : `/assets/img/logos/${name}`;
})();

const vc = verticalCopy(site);
const svc = vc.hasServicesNav
  ? (svcKeys ? SERVICES.filter((s) => svcKeys.includes(s.slug)) : SERVICES).map((s) => `<a href="/services/${s.slug}/">${s.nav}</a>`).join('')
  : '';
const areas = site.serviceAreas.map((a) => `<li>${a}</li>`).join('');
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand footer-brand" href="/">
          {site.enquirySite ? <img class="site-wordmark" src={`/assets/wordmarks/${site.domain}-inverse.svg`} alt={site.brand} width="260" height="54" loading="lazy" decoding="async" /> : <img class="brand__logo" width="64" height="64" src={footerLogo} alt={site.brand} loading="eager" decoding="async">}
        </a>
        <p class="footer-about">{site.enquirySite ? `An inquiry website for ${site.city}. Submit a request for review. Provider identity, coverage and appointment availability require confirmation.` : vc.tagline(site.city, site.county)}</p>
      </div>
      <div>
        <h2>Company</h2>
        <div class="footer-links">
          <a href="/">Home</a><a href="/about/">About</a>
          {vc.hasBlog && !site.enquirySite && <a href="/blog/">Blog</a>}
          <a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a>
        </div>
      </div>
      {vc.hasServicesNav && (
        <div>
          <h2>{site.enquirySite ? 'Service Guides' : 'Our Services'}</h2>
          <div class="footer-links" set:html={svc}></div>
        </div>
      )}
      <div>
        <h2>Get in Touch</h2>
        <ul class="footer-contact">
          {!site.hidePhone && <li><Fragment set:html={icon('phone', '', 19)} /><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>}
          <li><Fragment set:html={icon('mail', '', 19)} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Fragment set:html={icon('pin', '', 19)} /><span>{site.address.locality}, {site.address.region}</span></li>
          <li><Fragment set:html={icon('clock', '', 19)} /><span>Online requests accepted any time</span></li>
        </ul>
      </div>
    </div>
    <div class="footer-areas">
      <span class="footer-areas__label">{site.enquirySite ? 'Request location' : 'Service Areas'}</span>
      <ul class="footer-areas__list" set:html={areas}></ul>
    </div>
    <div class="footer-bottom">
      <span>&copy; <span data-year>2026</span> {site.brand}. All rights reserved.</span>
      <span><a href="/privacy-policy/">Privacy Policy</a> &nbsp;·&nbsp; <a href="/sitemap-index.xml">Sitemap</a></span>
    </div>
  </div>
</footer>
<div class="mobile-bar mobile-bar--single">
  <a class="btn btn-primary" href="/contact/#quote"><Fragment set:html={icon('send', '', 18)} /> Get A Free Quote</a>
</div>
<script src="/assets/js/main.js" defer></script>
<!-- Chat widget (n8n workflow; zero-config, skinned from
     theme-color meta, brand from og:site_name). Disable per-site with
     <meta name="hc-chat" content="off"> in the page head. -->
{!site.enquirySite && <script src="/assets/js/chat-widget.js" defer></script>}
