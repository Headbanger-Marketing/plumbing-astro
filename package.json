{
  "name": "plumbing-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Shared-source Astro project for the Headbanger plumbing city lead-gen sites. Forked from hvac-astro; single-trade. Clone-on-demand deploy into Headbanger-Marketing/<domain> GitHub Pages repos.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:site": "bash scripts/build-site.sh",
    "build:all": "python3 scripts/local-deploy.py --all-live --build-only",
    "deploy:site": "python3 scripts/local-deploy.py",
    "preview": "astro preview",
    "extract-configs": "python3 scripts/extract-config.py",
    "verify-parity": "python3 scripts/verify-site.py",
    "gen:chat-context": "node scripts/gen-chat-context.mjs",
    "test:chat-context": "python3 scripts/test-chat-context.py",
    "deploy:all": "python3 scripts/local-deploy.py --all-live",
    "assets:prepare": "python3 scripts/prepare-local-assets.py",
    "assets:check": "python3 scripts/prepare-local-assets.py --check",
    "test:local-deploy": "python3 scripts/test-local-deploy.py",
    "test:release": "python3 scripts/test-release.py && python3 scripts/test-form-contract.py && node --test scripts/test-release-browser.mjs",
    "release:worker": "python3 scripts/release-worker.py",
    "release:site": "python3 scripts/local-release.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
